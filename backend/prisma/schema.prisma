// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: ACADEMIC CORE
// ═══════════════════════════════════════════════════════════════════════════════

model AcademicYear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  isCurrent Boolean  @default(false)
  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  classes             Class[]
  sections            Section[]
  subjects            Subject[]
  students            Student[]
  teachers            Teacher[]
  enrollments         Enrollment[]
  feeStructures       FeeStructure[]
  leaves              Leave[]
  teacherSalaries     TeacherSalary[]
  teacherPerformances TeacherPerformance[]
  teacherSettings     TeacherSettings[]
  admissionCounters   AdmissionCounter[]
  attendances         Attendance[]
  exams               Exam[]
  examTerms           ExamTerm[]
  examResults         ExamResult[]
  hostelAllocations   HostelAllocation[]
  studentHistories    StudentHistory[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([tenantId, isCurrent])
  @@map("academic_years")
}

model Class {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  tenantId       String       @db.ObjectId
  academicYearId String       @db.ObjectId
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  teachers        TeacherClass[]
  subjects        Subject[]
  teacherSubjects TeacherSubject[] @relation("ClassTeacherSubjects")
  sections        Section[]
  enrollments     Enrollment[]
  timetables      Timetable[]
  classAgeConfigs ClassAgeConfig[]
  feeStructures   FeeStructure[]

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  @@index([tenantId, academicYearId])
  @@map("classes")
}

model Section {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  classId        String       @db.ObjectId
  tenantId       String       @db.ObjectId
  academicYearId String       @db.ObjectId
  class          Class        @relation(fields: [classId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  enrollments Enrollment[]
  timetables  Timetable[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([classId])
  @@map("sections")
}

model Subject {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  classId        String       @db.ObjectId
  tenantId       String       @db.ObjectId
  academicYearId String       @db.ObjectId
  class          Class        @relation(fields: [classId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  teachers       TeacherSubject[]
  timetables     Timetable[]
  examSchedules  ExamSchedule[]
  questionPapers QuestionPaper[]
  examResults    ExamResult[]

  periodsPerWeek Int      @default(6)
  isActive       Boolean  @default(true)
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([classId])
  @@map("subjects")
}


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: STUDENT MODULE
// ═══════════════════════════════════════════════════════════════════════════════

model Student {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  firstName String
  lastName  String
  fullName  String?
  gender    Gender
  dob       DateTime

  // Lookup FKs (replacing TEXT fields)
  bloodGroup    BloodGroup?
  religionId    String?     @db.ObjectId
  casteId       String?     @db.ObjectId
  categoryId    String?     @db.ObjectId
  nationalityId String?     @db.ObjectId

  aadharNo String?
  email    String?
  phone    String?
  address  String

  admissionNo String
  srNo        String?
  rollNumber  String?
  admissionDate DateTime @default(now())

  // Parent Info
  fatherName       String
  motherName       String
  fatherPhone      String
  motherPhone      String?
  fatherOccupation String?
  motherOccupation String?
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?

  photoUrl String?

  // Medical History
  medicalConditions  String[]
  allergies          String[]
  medications        String[]
  emergencyContact   String?
  emergencyPhone     String?
  insuranceId        String?
  lastMedicalCheckup DateTime?

  // Identification
  rfidCardNo     String?
  qrCode         String?
  biometricId    String?
  previousSchool String?
  previousClass  String?

  // Custom
  customFields Json?

  // Status
  status          String @default("active")
  statusChangedAt DateTime?
  statusChangedBy String?
  statusReason    String?
  verificationStatus String?

  // Relations
  tenantId       String @db.ObjectId
  academicYearId String @db.ObjectId
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  documents           StudentDocument[]
  enrollments         Enrollment[]
  studentHistories    StudentHistory[]
  attendance          Attendance[]
  promotions          Promotion[]
  transferCertificates TransferCertificate[]
  certificates        Certificate[]
  seatingArrangements SeatingArrangement[]
  admitCards          AdmitCard[]
  resultSummaries     ResultSummary[]
  achievements        StudentAchievement[]
  disciplinaryRecords StudentDisciplinaryRecord[]
  timeline            StudentTimelineEntry[]
  siblings            StudentSibling[]
  vaccinations        StudentVaccination[]
  credential          StudentCredential?
  hostelAllocations   HostelAllocation[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  updatedBy String?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([admissionNo, tenantId])
  @@index([srNo, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, academicYearId])
  @@index([tenantId, status, gender])
  @@index([tenantId, dob])
  @@map("students")
}

model StudentDocument {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String @db.ObjectId
  tenantId   String @db.ObjectId
  type       String
  name       String
  url        String
  mimeType   String?
  size       Int?
  student    Student @relation(fields: [studentId], references: [id])
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  uploadedAt DateTime @default(now())
  isDeleted  Boolean  @default(false)
  verificationStatus String?
  expiryDate DateTime?
  documentCategory   String?

  @@index([studentId])
  @@index([tenantId, type])
  @@map("student_documents")
}

model Enrollment {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String       @db.ObjectId
  classId        String       @db.ObjectId
  sectionId      String       @db.ObjectId
  academicYearId String       @db.ObjectId
  tenantId       String       @db.ObjectId
  rollNumber     String?
  status         String       @default("active")
  student        Student      @relation(fields: [studentId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  studentFees StudentFee[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([studentId, academicYearId])
  @@index([classId, sectionId, academicYearId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, sectionId, status])
  @@index([tenantId, status, academicYearId])
  @@map("enrollments")
}

model StudentHistory {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String        @db.ObjectId
  tenantId       String        @db.ObjectId
  action         String
  details        String        @default("{}")
  message        String?
  fromClassId    String?
  toClassId      String?
  fromSectionId  String?
  toSectionId    String?
  academicYearId String?       @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  performedBy    String
  student        Student       @relation(fields: [studentId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([studentId])
  @@index([tenantId, action])
  @@map("student_histories")
}

model Promotion {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId          String   @db.ObjectId
  tenantId           String   @db.ObjectId
  fromClassId        String
  fromSectionId      String
  fromAcademicYearId String
  toClassId          String
  toSectionId        String
  toAcademicYearId   String
  promotionType      String
  type               String
  remarks            String?
  promotedBy         String
  student            Student  @relation(fields: [studentId], references: [id])
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  promotedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([tenantId, fromAcademicYearId])
  @@index([studentId])
  @@map("promotions")
}

model AdmissionCounter {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String       @db.ObjectId
  academicYearId String       @db.ObjectId
  prefix         String       @default("ADM")
  lastNumber     Int          @default(0)
