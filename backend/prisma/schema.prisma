  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  username     String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([username, tenantId])
  @@map("student_credentials")
