// ═══════════════════════════════════════════════════════════════════════════════

model Certificate {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String            @db.ObjectId
  student         Student           @relation(fields: [studentId], references: [id])
  type            CertificateType
  serialNumber    String?
  certificateNo   String?
  issueDate       DateTime?
  reason          String?
  purpose         String?
  status          CertificateStatus @default(DRAFT)
  generatedBy     String?           @db.ObjectId
  studentName     String?
  metadata        Json?
  tenantId        String            @db.ObjectId
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([certificateNo])
  @@map("certificates")
}

model TransferCertificate {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String    @db.ObjectId
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  tcNumber            String
  studentId           String    @db.ObjectId
  student             Student   @relation(fields: [studentId], references: [id])
  reason              String?
  lastAttendanceDate  DateTime?
  remarks             String?
  generatedBy         String?   @db.ObjectId
  status              String    @default("DRAFT")
  dateOfAdmission     DateTime?
  dateOfLeaving       DateTime?
  classAtLeaving      String?
  conductAndCharacter String?
  generalRemarks      String?
  issueDate           DateTime?
  destinationSchool   String?
  issuedBy            String?   @db.ObjectId
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([studentId])
  @@unique([tcNumber, tenantId])
  @@map("transfer_certificates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 15: ASSET MODULE
// ═══════════════════════════════════════════════════════════════════════════════

model Asset {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  category      String
  serialNumber  String?
  assetCode     String?
  location      String?
  condition     AssetCondition @default(GOOD)
  purchaseDate  DateTime?
  purchasePrice Float?
  assignedTo    String?        @db.ObjectId
  tenantId      String         @db.ObjectId
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  issues        AssetIssue[]
  isActive      Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([serialNumber])
  @@map("assets")
}

model AssetIssue {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  assetId    String           @db.ObjectId
  issuedTo   String           @db.ObjectId
  issueDate  DateTime         @default(now())
  returnDate DateTime?
  status     AssetIssueStatus @default(ISSUED)
  tenantId   String           @db.ObjectId
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  asset      Asset            @relation(fields: [assetId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId])
  @@index([assetId])
  @@map("asset_issues")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 16: SETTINGS MODULE (Merged: Setting + SystemSetting + SystemSettings + PlatformSettings + SettingsMaster)
// ═══════════════════════════════════════════════════════════════════════════════

// Tenant-level settings (replaces Setting + SettingsMaster)
model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  module      String
  key         String
  value       String
  type        String   @default("STRING")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, module, key])
  @@map("system_settings")
}

// Global platform settings (replaces PlatformSettings + SystemSettings singleton)
model PlatformSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  category  String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("platform_settings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 17: ENTERPRISE & SUBSCRIPTION
// ═══════════════════════════════════════════════════════════════════════════════

model SubscriptionPlan {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String   @unique
  description    String?
  price          Float
  durationInDays Int
  currency       String   @default("INR")
  maxStudents    Int
  maxTeachers    Int
  maxAdmins      Int      @default(1)
  maxStorageInGB Int      @default(5)
  features       String[]
  isTrial        Boolean  @default(false)
  isPopular      Boolean  @default(false)
  isActive       Boolean  @default(true)
  subscriptions  TenantSubscription[]
  freeTrialRecords FreeTrialRecord[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@map("subscription_plans")
}

model TenantSubscription {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionCode String           @unique
  tenantId         String           @db.ObjectId
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  planId           String           @db.ObjectId
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])
  payments         SubscriptionPayment[]
  startDate        DateTime
  endDate          DateTime
  trialEndsAt      DateTime?
  cancelledAt      DateTime?
  status           SubscriptionStatus @default(PENDING)
  isActive         Boolean          @default(false)
  amount           Float
  currency         String           @default("INR")
  paymentStatus    PaymentStatus    @default(PENDING)
  paymentReference String?
  paymentGateway   String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  invoiceNumber    String?
  autoRenew        Boolean          @default(false)
  maxStudents      Int
  maxTeachers      Int
  maxAdmins        Int
  maxStorageInGB   Int
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([isActive])
  @@map("tenant_subscriptions")
}

model SubscriptionPayment {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String             @db.ObjectId
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])
  amount         Float
  currency       String             @default("INR")
  method         String?
  gateway        String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status         PaymentStatus      @default(PENDING)
  notes          String?
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@map("subscription_payments")
}

model FreeTrialRecord {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String           @db.ObjectId
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  userId            String           @db.ObjectId
  user              User             @relation(fields: [userId], references: [id])
  email             String
  phone             String?
  name              String?
  address           String?
  city              String?
  ipAddress         String?
  deviceFingerprint String?
  userAgent         String?
  planId            String           @db.ObjectId
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  planName          String
  usedAt            DateTime         @default(now())

  @@index([email])
  @@index([tenantId])
  @@index([userId])
  @@map("free_trial_records")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])
  tenantId     String?  @db.ObjectId
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  token        String
  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  os           String?
  location     String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@map("sessions")
  @@index([tenantId])
}

model RolePermission {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  userId   String @db.ObjectId
  role     String

  canViewStudents    Boolean @default(true)
  canEditStudents    Boolean @default(false)
  canViewAttendance  Boolean @default(true)
  canMarkAttendance  Boolean @default(false)
  canViewResults     Boolean @default(true)
  canEnterMarks      Boolean @default(false)
  canViewFees        Boolean @default(false)
  canCollectFees     Boolean @default(false)
  canViewReports     Boolean @default(true)
  canManageLibrary   Boolean @default(false)
  canViewTimetable   Boolean @default(true)
  canManageTimetable Boolean @default(false)
  canViewLeave       Boolean @default(true)
  canApproveLeave    Boolean @default(false)
  canViewSalary      Boolean @default(false)
  isTemporaryAdmin   Boolean  @default(false)
  tempAdminExpiry    DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  action     String
  entity     String
  entityId   String
  entityType String?
  type       String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  rolledBack Boolean  @default(false)
  userName   String?
  userRole   String?
  module     String?
  severity   String?
  performedBy String?
  isRollbackable Boolean @default(false)
  tenantId   String   @db.ObjectId
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model LoginHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  userName     String
  userRole     String
  action       String
  ipAddress    String?
  userAgent    String?
  browser      String?
  device       String?
  os           String?
  location     String?
  sessionId    String?
  loginAt      DateTime @default(now())
  logoutAt     DateTime?
  duration     Int?
  isSuccessful Boolean  @default(true)
  failReason   String?
  tenantId     String   @db.ObjectId
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, createdAt])
  @@map("login_histories")
}

// Merged: Ticket + SupportTicket → Ticket
model Ticket {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String       @db.ObjectId
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  ticketNumber String       @unique
  title        String
  description  String
  category     String?
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  raisedBy     String?      @db.ObjectId
  reporter     User?        @relation("TicketReporter", fields: [raisedBy], references: [id])
  raisedByRole String?
  assignedTo   String?      @db.ObjectId
  assignee     User?        @relation("TicketAssignee", fields: [assignedTo], references: [id])
  resolution   String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  attachments  String[]     @default([])
  tags         String[]     @default([])
  comments     TicketComment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String   @db.ObjectId
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  message    String
  author     String
  authorRole String?
  isInternal Boolean  @default(false)
  attachments String[] @default([])
  tenantId   String   @db.ObjectId
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
  @@index([tenantId])
}


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 18: WORKFLOW, EVENTS, FORMS, REPORTS, UTILITY MODULES
// ═══════════════════════════════════════════════════════════════════════════════

model Workflow {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  module       String
  triggerEvent String
  description  String?
  steps        Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  instances    WorkflowInstance[]

  @@index([tenantId])
  @@map("workflows")
}

model WorkflowInstance {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String   @db.ObjectId
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  workflowId      String   @db.ObjectId
  workflow        Workflow  @relation(fields: [workflowId], references: [id])
  entityId        String
  entityType      String
  currentStep     Int      @default(1)
  totalSteps      Int      @default(1)
  status          String   @default("PENDING")
  initiatedBy     String   @db.ObjectId
  initiatorName   String?
  data            Json?
  currentAssignees String[]
  history         Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("workflow_instances")
}

model Event {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String         @db.ObjectId
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  title        String
  description  String?
  type         String         @default("OTHER")
  startDate    DateTime
  endDate      DateTime
  startTime    String?
  endTime      String?
  venue        String?
  organizer    String?
  participants String[]       @default([])
  isPublic     Boolean        @default(true)
  status       String         @default("UPCOMING")
  attachments  String[]       @default([])
  budget       Float?
  actualCost   Float?
  notes        String?
  color        String?        @default("#4f46e5")
  categoryId   String?        @db.ObjectId
  category     EventCategory? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([tenantId, startDate])
  @@map("events")
}

model EventCategory {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String   @db.ObjectId
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  name     String
  color    String   @default("#4f46e5")
  icon     String?
  events   Event[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("event_categories")
}

model GatePass {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String    @db.ObjectId
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  visitorName    String
  visitorPhone   String
  purpose        String
  visitingPerson String
  department     String?
  entryTime      DateTime?
  exitTime       DateTime?
  vehicleNumber  String?
  idProofType    String?
  idProofNumber  String?
  photo          String?
  status         String    @default("PENDING")
  approvedBy     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([tenantId, status])
  @@map("gate_passes")
}

model GatePassSetting {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId                String   @unique @db.ObjectId
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  requireApproval         Boolean  @default(true)
  autoApproveAfterMinutes Int?
  notifyOnEntry           Boolean  @default(true)
  notifyOnExit            Boolean  @default(false)
  allowedPurposes         String[] @default(["Meeting", "Delivery", "Interview", "Parent Visit", "Vendor", "Other"])
  workingHoursStart       String?  @default("08:00")
  workingHoursEnd         String?  @default("18:00")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("gate_pass_settings")
}

model FormTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  module      String?
  fields      Json?
