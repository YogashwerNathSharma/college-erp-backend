{
  "name": "backend",
  "version": "1.0.0",
  "description": "ERP Backend",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "node scripts/ensure-school-master-fields.js && node scripts/ensure-branch-master-fields.js && node scripts/ensure-campus-master-fields.js && node scripts/ensure-subject-group-master-fields.js && node scripts/ensure-department-hod-lookup.js && node scripts/ensure-fee-group-class-lookup.js",
    "build": "node scripts/ensure-school-master-fields.js && node scripts/ensure-branch-master-fields.js && node scripts/ensure-campus-master-fields.js && node scripts/ensure-subject-group-master-fields.js && node scripts/ensure-department-hod-lookup.js && node scripts/ensure-fee-group-class-lookup.js && npx prisma generate && tsc",
    "prestart": "node scripts/ensure-department-hod-lookup.js && node scripts/ensure-fee-group-class-lookup.js",
    "start": "node dist/server.js",
    "seed": "ts-node prisma/seed.ts",
    "seed-erp": "ts-node prisma/seed-erp.ts",
    "seed-superadmin": "ts-node prisma/seed-superadmin.ts"
  },
  "prisma": { "seed": "ts-node prisma/seed.ts" },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^6.19.0",
    "archiver": "^7.0.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.1.0",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.17.2",
    "puppeteer-core": "^24.31.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react-icons": "^5.5.0",
    "redis": "^5.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.6",
    "winston": "^3.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^5.0.1",
    "@types/ua-parser-js": "^0.7.39",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  }
}
