// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: TEACHER & STAFF MODULE (Merged Teacher + Staff + TeacherLeave + Leave + LeaveRequest → unified)
// ═══════════════════════════════════════════════════════════════════════════════

model Teacher {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  name      String
  email     String @unique
  phone     String
  gender    Gender?
  dob       DateTime?
  employeeId    String?
  maritalStatus String?
  photoUrl      String?

  tenantId       String       @db.ObjectId
  academicYearId String       @db.ObjectId
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  // FK to masters (replacing TEXT fields)
  departmentId  String? @db.ObjectId
  designationId String? @db.ObjectId

  subjects      TeacherSubject[]
  classes       TeacherClass[]
  timetables    Timetable[]
  leaves        Leave[]         @relation("TeacherLeaves")
  salaries      TeacherSalary[]
  performances  TeacherPerformance[]
  documents     TeacherDocument[]
  invigilatorAssignments InvigilatorAssignment[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([academicYearId])
  @@index([employeeId])
  @@map("teachers")
}

model TeacherSubject {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String  @db.ObjectId
  subjectId String  @db.ObjectId
  classId   String? @db.ObjectId
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  class     Class?  @relation("ClassTeacherSubjects", fields: [classId], references: [id])
  isDeleted Boolean @default(false)
  deletedAt DateTime?

  @@map("teacher_subjects")
}

model TeacherClass {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String  @db.ObjectId
  classId   String  @db.ObjectId
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  class     Class   @relation(fields: [classId], references: [id])
  isDeleted Boolean @default(false)
  deletedAt DateTime?

  @@map("teacher_classes")
}

model Staff {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String    @db.ObjectId
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  firstName       String
  lastName        String
  employeeId      String
  gender          Gender?
  // FK to masters (replacing TEXT fields)
  departmentId    String?   @db.ObjectId
  designationId   String?   @db.ObjectId
  phone           String?
  email           String?
  joiningDate     DateTime?
  basicSalary     Float?
  travelAllowance Float?
  otherAllowances Float?
  tdsPercentage   Float?
  otherDeductions Float?
  isDeleted       Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payrolls         Payroll[]
  leaves           Leave[]          @relation("StaffLeaves")
  staffAttendances StaffAttendance[]
  @@index([tenantId, employeeId])
  @@map("staff")
}

// ─── UNIFIED LEAVE (Merged: TeacherLeave + Leave + LeaveRequest) ───
model Leave {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String      @db.ObjectId
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  academicYearId String?     @db.ObjectId
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  // Polymorphic: either teacher or staff
  teacherId String?  @db.ObjectId
  teacher   Teacher? @relation("TeacherLeaves", fields: [teacherId], references: [id])
  staffId   String?  @db.ObjectId
  staff     Staff?   @relation("StaffLeaves", fields: [staffId], references: [id])

  leaveTypeId String?  @db.ObjectId  // FK to LeaveType master
  leaveType   String               // Denormalized name for quick access
  startDate   DateTime
  endDate     DateTime
  days        Int?
  reason      String
  status      LeaveStatus @default(PENDING)
  approvedBy  String?     @db.ObjectId
  approvedAt  DateTime?
  remarks     String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([teacherId, status])
  @@index([staffId, status])
  @@index([tenantId, academicYearId])
  @@map("leaves")
}

model TeacherSalary {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  teacherId       String       @db.ObjectId
  month           Int
  year            Int
  basicSalary     Float
  allowances      Json
  deductions      Json
  totalAllowances Float
  totalDeductions Float
  netSalary       Float
  status          PayrollStatus @default(PENDING)
  paidAt          DateTime?
  tenantId        String       @db.ObjectId
  academicYearId  String       @db.ObjectId
  teacher         Teacher      @relation(fields: [teacherId], references: [id])
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  isDeleted       Boolean      @default(false)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([teacherId, month, year])
  @@index([tenantId, academicYearId])
