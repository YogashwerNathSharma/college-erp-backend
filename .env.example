# ═══════════════════════════════════════════════════════════════
# College ERP — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your actual values
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────
# DATABASE
# ──────────────────────────────────────
# MongoDB Atlas (cloud):
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/college-erp?retryWrites=true&w=majority
# Docker local:
# DATABASE_URL=mongodb://admin:your_password@mongodb:27017/college_erp?authSource=admin
DATABASE_URL=mongodb://localhost:27017/college_erp

# Docker MongoDB credentials
MONGO_USERNAME=admin
MONGO_PASSWORD=your_secure_mongo_password

# ──────────────────────────────────────
# SERVER
# ──────────────────────────────────────
PORT=5000
NODE_ENV=development
# Backend base URL (used in emails, links)
BASE_URL=http://localhost:5000
# Frontend URL (for CORS, redirect links)
FRONTEND_URL=http://localhost:5174
# CORS allowed origin (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5174
# Log level: error, warn, info, debug
LOG_LEVEL=info
# Disable keep-alive self-ping in dev
KEEP_ALIVE=false

# ──────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
JWT_SECRET=change-this-to-a-very-long-random-secret-string-in-production
# Token expiry (e.g. 1d, 7d, 30d)
JWT_EXPIRES_IN=7d
# Optional: separate refresh token secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# ──────────────────────────────────────
# RAZORPAY (Payment Gateway)
# ──────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ──────────────────────────────────────
# CLOUDINARY (Image/File Storage)
# ──────────────────────────────────────
# Get credentials from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────────────
# EMAIL (SMTP)
# ──────────────────────────────────────
# Gmail: smtp.gmail.com (port 587, use App Password)
# Resend: smtp.resend.com
# Mailtrap (testing): smtp.mailtrap.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=College ERP
SMTP_EMAIL=noreply@your-school.com

# ──────────────────────────────────────
# SMS (Optional)
# ──────────────────────────────────────
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=SCHOOL
SMS_API_URL=https://api.textlocal.in/send/

# ──────────────────────────────────────
# WHATSAPP (Optional)
# ──────────────────────────────────────
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_URL=https://graph.facebook.com/v17.0

# ──────────────────────────────────────
# REDIS (Optional — for caching)
# ──────────────────────────────────────
# Uncomment if using Redis
# REDIS_URL=redis://localhost:6379
# Or use individual settings:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ──────────────────────────────────────
# AI ASSISTANT (Optional)
# ──────────────────────────────────────
# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# ──────────────────────────────────────
# FIREBASE (Optional — Push Notifications)
# ──────────────────────────────────────
# Base64-encoded Firebase service account JSON
# FIREBASE_SERVICE_ACCOUNT_KEY=base64_encoded_json

# ──────────────────────────────────────
# FILE UPLOAD
# ──────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# ──────────────────────────────────────
# BRANDING (Optional — white-label)
# ──────────────────────────────────────
APP_NAME=College ERP
APP_TAGLINE=Smart School Management
PRIMARY_COLOR=#6366f1
LOGO_URL=
FAVICON_URL=

# ──────────────────────────────────────
# DOCKER-SPECIFIC
# ──────────────────────────────────────
# Frontend port when running via docker-compose
FRONTEND_PORT=80

# ──────────────────────────────────────
# RENDER DEPLOYMENT
# ──────────────────────────────────────
# Auto-set by Render
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
